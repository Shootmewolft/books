# Absolute base URL of the deployed site.
# Used for canonical links, hreflang alternates, Open Graph URLs, the sitemap
# and robots.txt. Without it everything falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Public base URL of the R2 bucket holding the books.
# When set, /api/file/* redirects here instead of reading from disk, so the
# bytes never pass through Vercel — R2 egress is free, Vercel bandwidth is not.
# Leave unset locally to serve straight from the library/ directory.
LIBRARY_CDN_URL=https://books.your-domain.com

# Absolute path to the library on disk. Defaults to the sibling library/
# directory. Only needed if the books live somewhere else locally.
# LIBRARY_PATH=/mnt/books

# --- Uploading to R2 (pnpm library:upload) ---
# Never commit these. Create an R2 API token scoped to the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=library
