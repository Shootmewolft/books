{
  "name": "la-biblioteca-del-software",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "La Biblioteca del Software \u2014 a curated library of software engineering books with a built-in reader.",
  "author": "Shoot (https://github.com/shootmewolft)",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @library/web dev",
    "build": "pnpm --filter @library/web build",
    "start": "pnpm --filter @library/web start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "library:add": "node tools/library/add.ts",
    "library:validate": "node tools/library/validate.ts",
    "library:covers": "node tools/library/covers.ts",
    "library:readme": "node tools/library/readme.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm library:validate",
    "typecheck": "tsc -p tools/tsconfig.json && pnpm --filter @library/web typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.1.2",
    "sharp": "^0.35.3",
    "typescript": "5.9.3"
  }
}
