{
  "name": "shoot-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A curated, self-hosted library of software engineering books with a server-rendered reader.",
  "author": "Shoot (https://github.com/shootmewolft)",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @library/web dev",
    "build": "pnpm --filter @library/web build",
    "start": "pnpm --filter @library/web start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "library:validate": "node tools/library/validate.mjs",
    "library:covers": "node tools/library/covers.mjs",
    "library:readme": "node tools/library/readme.mjs",
    "check": "pnpm lint && pnpm library:validate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "sharp": "^0.35.3"
  }
}
