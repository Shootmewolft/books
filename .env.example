# Absolute base URL of the deployed site.
# Used for canonical links, hreflang alternates, Open Graph URLs, the sitemap
# and robots.txt. Without it everything falls back to http://localhost:3000,
# which is fine locally but wrong in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Absolute path to the library. Defaults to the sibling library/ directory.
# Set this only if the books live outside the repository.
# LIBRARY_PATH=/mnt/books
